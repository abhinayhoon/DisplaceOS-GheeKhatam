generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReliefCamp {
  id               String   @id @default(cuid())
  name             String
  district         String
  lat              Float
  lng              Float
  capacity         Int
  currentOccupancy Int
  status           String // CRITICAL | STABLE | OVERFLOW
  foodPackets      Int
  waterLiters      Int
  medicalKits      Int
  shelterTents     Int
  burnRatePerHour  Int
  facilitiesJson   String   @default("{}")
  verificationJson String   @default("{}")
  updatedAt        DateTime @updatedAt
  survivors        DisplacedPerson[]
  requests         ResourceRequest[]
  dispatches       RescueDispatch[]
}

model ResourceRequest {
  id             String   @id @default(cuid())
  campId         String
  campName       String
  district       String
  resourceType   String // FOOD | WATER | MEDICINE | SHELTER | EVACUATION
  quantityNeeded Int
  urgencyScore   Int
  status         String // PENDING | ALLOCATED | IN_TRANSIT | DELIVERED
  duplicateFlag  Boolean  @default(false)
  reasoningJson  String
  createdAt      DateTime @default(now())
  camp           ReliefCamp @relation(fields: [campId], references: [id], onDelete: Restrict)
  dispatches     RescueDispatch[]
}

model SupplyDepot {
  id           String @id @default(cuid())
  name         String
  district     String
  foodStock    Int
  waterStock   Int
  medicineStock Int
  shelterStock Int
}

model RescueDispatch {
  id             String @id @default(cuid())
  teamName       String
  unitCode       String
  vehicleType    String // NDRF_BOAT | HELI_AIRLIFT | HEAVY_TRUCK
  originName     String
  targetCampId   String
  targetCampName String
  resourceType   String
  quantity       Int
  etaMinutes     Int
  routeStatus    String // CLEAR | LANDSLIDE_DETOUR | DELIVERED
  progressPercent Int
  stockApplied   Boolean @default(false)
  targetCamp     ReliefCamp @relation(fields: [targetCampId], references: [id], onDelete: Restrict)
  requestId      String?
  request        ResourceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model DisplacedPerson {
  id              String @id @default(cuid())
  fullName        String
  age             Int
  medicalNeeds    String
  currentCampName String
  campId          String
  district        String
  familyGroupCode String
  status          String // SAFE_IN_CAMP | NEEDS_MEDEVAC | REUNITED
  camp            ReliefCamp @relation(fields: [campId], references: [id], onDelete: Restrict)
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  approved      Boolean   @default(false)
  image         String?
  role          String    @default("RELIEF_CAMP") // GOV_AGENCY | RELIEF_CAMP | RESCUE_TEAM
  campId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TriageWeights {
  id               String   @id
  routeReliability Float    @default(1)
  burnDrift        Float    @default(1)
  facilityPenalty  Float    @default(0.25)
  historyJson      String   @default("[]")
  verificationHead String   @default("GENESIS")
  updatedAt        DateTime @updatedAt
}

model VerificationLog {
  id             String   @id @default(cuid())
  campId         String
  campName       String
  source         String
  reported       Int
  modelExpected  Int
  groundTruth    Int
  accuracyBefore Int
  accuracyAfter  Int
  hash           String
  prevHash       String
  by             String
  createdAt      DateTime @default(now())
}

model TelemetryEvent {
  id        String   @id @default(cuid())
  kind      String
  message   String
  createdAt DateTime @default(now())
}

model ActionReceipt {
  id           String   @id
  actorBadgeId String
  createdAt    DateTime @default(now())
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
}
